# merge sort

# step:1 two merge and sorted array return
def merge_sort(arr_1,arr_2):
    # initially creation of the new array
    sort_arr = []
    i = 0 
    j = 0 
    k = 0

    # condition checking 
    while i < len(arr_1) and j < len(arr_2):

        # if first array less than second array 
        if arr_1[i] < arr_2[j]:
            # append the first value of the array
            sort_arr.append(arr_1[i])
            i += 1
            k += 1
        
        else:
            # if not append the second array
            sort_arr.append(arr_2[j])
            j += 1
            k += 1

    # if there is no moving index of second array
    while i < len(arr_1):
        # balance array will be inserted
        sort_arr.append(arr_1[i])
        i += 1
        k += 1
    # if there is no moving index of second array
    while j < len(arr_2):
        # balance array will be inserted
        sort_arr.append(arr_1[j])
        j += 1
        k += 1
    return sort_arr
def testing():

    # test case 1
    arr1 = [1,3,7,9]
    arr2 = [1,2,5,6]
    print(merge_sort(arr1,arr2))

    # testing case 2
    arr3 = [1, 3, 5, 7]
    arr4 = [2, 4, 6]
    print(merge_sort(arr3,arr4))


testing()
