# method 2 of the insertion sort

def insertion_sort(arr):

    # dividing a arr1 and arr2 in one list
    f_start = 0
    f_end = round(len(arr)/2)
    s_start = round(len(arr)/2)
    s_end = len(arr) 
    new = []

        

    while f_start < f_end and s_start < s_end:

        if arr[f_start] < arr[s_start]:   
            
            new.append(arr[f_start])
            f_start += 1

        else:
            
            new.append(arr[s_start])
            s_start += 1
            
            

    while f_start < f_end:
            new.append(arr[f_start])
            f_start += 1
            
    
    while s_start < s_end:
            new.append(arr[s_start])
            s_start += 1

    return new


def testing():
    
    # testcase
    arr_1 = [1,2,5,6,1,3,7,9]
    print(insertion_sort(arr_1))


testing()
